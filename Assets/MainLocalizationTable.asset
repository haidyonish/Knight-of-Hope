  - key: stats_completion_bonus
    english: Completion Bonus
    russian: "\u0411\u043E\u043D\u0443\u0441 \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435"
  - key: stats_ambition
    english: Ambition
    russian: "\u0410\u043C\u0431\u0438\u0446\u0438\u0438"
  - key: common_yes
    english: Yes
    russian: "\u0414\u0430"
  - key: common_no
    english: No
    russian: "\u041D\u0435\u0442"
  - key: cursed_build_title
    english: Cursed Build
    russian: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0439 \u0431\u0438\u043B\u0434"
  - key: cursed_build_description
    english: Even the creator of the game did not believe it was possible.\n\nBut
      the great Dade5o managed to complete it to the very end.\n\nAnd since then,
      it became clear:\nthere is no curse that cannot be overcome by a madman willing
      to try one more time.
    russian: "\u0414\u0430\u0436\u0435 \u0441\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u044C
      \u0438\u0433\u0440\u044B \u043D\u0435 \u0432\u0435\u0440\u0438\u043B, \u0447\u0442\u043E
      \u044D\u0442\u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E.\\n\\n\u041D\u043E
      \u0412\u0435\u043B\u0438\u043A\u0438\u0439 Dade5o \u0441\u0443\u043C\u0435\u043B
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0435\u0433\u043E \u0434\u043E \u043A\u043E\u043D\u0446\u0430.\\n\\n\u0418
      \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440 \u0441\u0442\u0430\u043B\u043E
      \u044F\u0441\u043D\u043E:\\n\u043D\u0435\u0442 \u0442\u0430\u043A\u043E\u0433\u043E
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u044C
      \u0431\u0435\u0437\u0443\u043C\u0435\u0446, \u0433\u043E\u0442\u043E\u0432\u044B\u0439
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u0435\u0449\u0451
      \u0440\u0430\u0437."
  - key: upgrade_score_multiplier_name
    english: Ambition
    russian: "\u0410\u043C\u0431\u0438\u0446\u0438\u0438"
  - key: upgrade_score_multiplier_desc
