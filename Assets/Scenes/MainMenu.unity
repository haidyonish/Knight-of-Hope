  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "    \u041A\u0430\u0436\u0434\u044B\u0439 \u0440\u0430\u0437 \u043F\u0440\u0438
    \u0441\u043C\u0435\u043D\u0435 \u0438\u043C\u0435\u043D\u0438 \u0438\u0434\u0451\u0442
    \u0437\u0430\u043F\u0440\u043E\u0441 \u0432 \u0411\u0414. \u0410 \u0431\u0430\u0437\u0430
    \u0434\u0430\u043D\u043D\u044B\u0445 \u0443 \u043C\u0435\u043D\u044F \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F.\r\n\r\n   
    \u0416\u0435\u0441\u0442\u043E\u043A\u0430\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0430
    \u0441\u0442\u0443\u0434\u0435\u043D\u0447\u0435\u0441\u043A\u043E\u0439 \u043D\u0438\u0449\u0435\u0442\u044B:
    10 000 \u0437\u0430\u043F\u0440\u043E\u0441\u043E\u0432 \u0432 \u043C\u0435\u0441\u044F\u0446.
    \u041E\u0434\u0438\u043D \u0437\u0430\u043F\u0440\u043E\u0441 - \u0441\u043C\u0435\u043D\u0430
    \u043D\u0438\u043A\u0430 \u0418\u041B\u0418 \u043F\u043E\u0431\u0438\u0442\u044B\u0439
    \u0440\u0435\u043A\u043E\u0440\u0434.\r\n\r\n    \u0411\u0443\u0434\u044C\u0442\u0435
    \u043B\u044E\u0434\u044C\u043C\u0438:\r\n- \u041D\u0435 \u043C\u0435\u043D\u044F\u0439\u0442\u0435
    \u043D\u0438\u043A 50 \u0440\u0430\u0437 \u0437\u0430 \u043C\u0438\u043D\u0443\u0442\u0443
    \xAB\u0434\u043B\u044F \u0442\u0435\u0441\u0442\u0430\xBB\r\n- \u041D\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0442\u0435
    \u0411\u0414 \u043F\u043B\u0430\u043A\u0430\u0442\u044C\r\n\r\n    \u0417\u0430
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u0441\u0438\u0434\u0438\u0442 \u0441\u0442\u0443\u0434\u0435\u043D\u0442
    \u0441 \u0433\u043E\u0440\u044F\u0449\u0438\u043C \u0434\u0435\u0434\u043B\u0430\u0439\u043D\u043E\u043C
    \u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u044B\u043C \u0442\u0430\u0440\u0438\u0444\u043E\u043C.\r\n\r\n   
    \u0421\u043C\u0435\u043D\u0438\u043B\u0438 \u0438\u043C\u044F \u0440\u0430\u0437
    - \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E. \u0414\u0432\u0430
    - \u043E\u043A\u0435\u0439. \u0414\u0435\u0441\u044F\u0442\u044C - \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u0435
    \u0441\u0435\u0431\u044F: \xAB\u0410 \u043D\u0435 \u0441\u0442\u0430\u043D\u0443
    \u043B\u0438 \u044F \u0442\u0435\u043C, \u043A\u0442\u043E \u0434\u043E\u0431\u044C\u0451\u0442
    \u043B\u0438\u043C\u0438\u0442 \u0438 \u043B\u0438\u0448\u0438\u0442 \u0432\u0441\u0435\u0445
    \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043A\u0438?\xBB\r\n\r\n   
    \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C. "
